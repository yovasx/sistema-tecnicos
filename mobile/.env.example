# Copiá este archivo a `.env.local` y ajustá la URL según dónde corras la app.
# Expo inyecta las variables EXPO_PUBLIC_* al compilar el bundle.

# Web / simulador iOS:
EXPO_PUBLIC_API_URL=http://localhost:9080

# Emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:9080

# Teléfono físico (IP LAN de la PC):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:9080

# Google opcional. Vacío = oculto. Son IDs públicos, NUNCA el client secret.
# El Web client ID también se agrega a GOOGLE_CLIENT_IDS en el backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Nativo requiere development build y la configuración real de Google Cloud.
EXPO_PUBLIC_GOOGLE_NATIVE_ENABLED=false
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Solo configuración de build; no se envía al backend.
GOOGLE_IOS_URL_SCHEME=
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE=
