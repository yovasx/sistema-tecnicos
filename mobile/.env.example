# Copiá este archivo a `.env.local` y ajustá la URL según dónde corras la app.
# Expo inyecta las variables EXPO_PUBLIC_* al compilar el bundle.

# Web / simulador iOS:
EXPO_PUBLIC_API_URL=http://localhost:9080

# Emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:9080

# Teléfono físico (IP LAN de la PC):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:9080
