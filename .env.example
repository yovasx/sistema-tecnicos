# Postgres para docker-compose (dev). Cambiar la contraseña en producción.
POSTGRES_DB=tecnicos_db
POSTGRES_USER=tecnicos_user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Puerto del backend en el host (el contenedor sigue escuchando en 8080)
BACKEND_PORT=9080

# Autenticación (se usa en el siguiente paso).
# Generar el secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=reemplazar-por-base64-de-32-bytes
JWT_ISSUER=tecnicos-api
JWT_TTL_MINUTES=30

# Primer administrador (bootstrap idempotente; no se commitea el .env real)
ADMIN_EMAIL=admin@tecnicos.local
ADMIN_PASSWORD=Admin1234!

# Orígenes permitidos para Expo web
CORS_ALLOWED_ORIGINS=http://localhost:9081
