# Postgres para docker-compose (dev). Cambiar la contraseña en producción.
POSTGRES_DB=tecnicos_db
POSTGRES_USER=tecnicos_user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Puerto del backend en el host (el contenedor sigue escuchando en 8080)
BACKEND_PORT=9080

# Autenticación. El secreto debe ser Base64 de al menos 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si queda vacío, el backend usa un secreto de desarrollo y avisa por log.
JWT_SECRET=
# Spring Security compara el emisor como URL: tiene que ser http(s) absoluta.
JWT_ISSUER=https://api.fixly.bo
JWT_TTL_MINUTES=30

# RabbitMQ (mensajería interna; todavía sin publishers/consumers)
RABBITMQ_USER=tecnicos
RABBITMQ_PASSWORD=tecnicos
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Primer administrador (bootstrap idempotente; no se commitea el .env real)
ADMIN_EMAIL=admin@tecnicos.local
ADMIN_PASSWORD=Admin1234!

# Orígenes permitidos para Expo web
CORS_ALLOWED_ORIGINS=http://localhost:9081

# Email OTP. En desarrollo Docker usa Mailpit: emails en http://localhost:8025.
# Para producción configurá un proveedor SMTP real (no publicar Mailpit).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-responder@fixly.bo
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
