# Opcional para Docker Compose local: sin .env se usan estos defaults.
# Solo desarrollo/demo: las migraciones incluyen cuentas de prueba conocidas.
# No publicar este stack en Internet sin endurecer configuración, datos y TLS.
POSTGRES_DB=tecnicos_db
POSTGRES_USER=tecnicos_user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Puerto del backend en el host (el contenedor sigue escuchando en 8080)
BACKEND_PORT=9080
WEB_PORT=9081
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# Autenticación. El secreto debe ser Base64 de al menos 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si queda vacío, el backend usa un secreto de desarrollo y avisa por log.
JWT_SECRET=
# Spring Security compara el emisor como URL: tiene que ser http(s) absoluta.
JWT_ISSUER=https://api.fixly.bo
JWT_TTL_MINUTES=30

# RabbitMQ (mensajería interna; todavía sin publishers/consumers)
RABBITMQ_USER=tecnicos
RABBITMQ_PASSWORD=tecnicos
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Orígenes para clientes que llaman directamente al backend (Expo/Metro).
# La web Docker usa el proxy /api del mismo origen.
CORS_ALLOWED_ORIGINS=http://localhost:9081

# Email OTP. En desarrollo Docker usa Mailpit: emails en http://localhost:8025.
# Para producción configurá un proveedor SMTP real (no publicar Mailpit).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-responder@fixly.bo
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# Google Identity: Web client IDs permitidos (separados por coma). Vacío deshabilita.
# Deben coincidir con EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID de la app.
# La web Docker toma este ID del .env RAÍZ, no de mobile/.env.local.
# En Google Cloud autorizá también el origen público de la web (ej. http://localhost:9081).
GOOGLE_CLIENT_IDS=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_MAPA_TILES_URL=
EXPO_PUBLIC_MAPA_ATRIBUCION=
# El ID web se incorpora al compilar: cambiarlo exige docker compose up -d --build web.
